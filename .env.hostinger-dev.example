# Copie para .env.hostinger-dev (ignorado pelo Git).
# Use exclusivamente um banco SEPARADO de desenvolvimento, inicialmente vazio.
# Aspas simples preservam caracteres especiais na senha no Docker Compose.
HOSTINGER_DB_CONNECTION=mysql
HOSTINGER_DB_HOST=
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_DATABASE=
HOSTINGER_DB_USERNAME=
HOSTINGER_DB_PASSWORD=
# Chave própria deste ambiente; não substitua APP_KEY do ambiente local.
HOSTINGER_APP_KEY=
# Opcional: caminho do certificado CA dentro do contêiner, se fornecido pelo provedor.
HOSTINGER_MYSQL_SSL_CA=
