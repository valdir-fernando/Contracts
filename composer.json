{
    "name": "contracts/app",
    "type": "project",
    "description": "Contracts application",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "phpoffice/phpspreadsheet": "^5.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check:architecture": "@php vendor/bin/phpunit --testsuite=Architecture --do-not-cache-result",
        "test:unit": "@php vendor/bin/phpunit --testsuite=Unit --do-not-cache-result",
        "check": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpunit --do-not-cache-result"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
